      <a name="text" val="S3 AND S2 ,i.e., 15 &gt;= sum &gt;= 12"/>
    </comp>
    <comp lib="9" loc="(764,225)" name="Text">
      <a name="text" val="S3 AND S1 ,i.e., 11 &gt;= sum &gt;= 10"/>
